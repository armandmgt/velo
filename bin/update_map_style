#!/bin/bash

# Configuration
# Martin URL for Shortbread source
BASE_URL="https://velo.armandmgt.fr/tiles/addresses,aerialways,boundaries,boundary_labels,bridges,buildings,dam_lines,dam_polygons,ferries,land,pier_lines,pier_polygons,place_labels,pois,public_transport,sites,street_labels,street_polygons,streets,streets_labels_points,streets_low,streets_med,streets_polygons_labels,water_lines,water_lines_labels,water_polygons,water_polygons_labels"
GLYPHS_URL="<%= root_url %>/fonts/{fontstack}/{range}.pbf"
SPRITE_URL="<%= root_url %>/sprites/basics/sprites"
OUTPUT_FILE="app/views/map_styles/show.json.erb"

# Move to the project root
PROJECT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$PROJECT_ROOT" || exit 1

echo "Updating $OUTPUT_FILE using @versatiles/style..."

# Use npx to run a Node.js script that generates the JSON
# We use a temporary directory to avoid cluttering the project with node_modules
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR" || exit 1

npm init -y > /dev/null
npm install @versatiles/style > /dev/null

node -e "
const m = require('@versatiles/style');
const style = new m.colorful({
  baseUrl: '$BASE_URL/',
  glyphs: '$GLYPHS_URL',
  sprite: [{ id: 'basics', url: '$SPRITE_URL' }]
});
style.glyphs = '$GLYPHS_URL';
style.sprite[0].url = '$SPRITE_URL';
style.sources['versatiles-shortbread'].tiles[0] = '$BASE_URL/{z}/{x}/{y}';
console.log(JSON.stringify(style, null, 2));
" > "$PROJECT_ROOT/$OUTPUT_FILE"

echo "Done. Style JSON updated successfully."
