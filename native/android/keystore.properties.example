# Copy this file to keystore.properties and fill in real values.
# keystore.properties is gitignored — never commit it.
#
# Generate the keystore once:
#   keytool -genkey -v -keystore velo-release.jks -alias velo \
#     -keyalg RSA -keysize 2048 -validity 10000
# Then move velo-release.jks somewhere outside the repo (or keep in native/android/ — it's gitignored).

storeFile=../velo-release.jks
storePassword=changeme
keyAlias=velo
keyPassword=changeme
