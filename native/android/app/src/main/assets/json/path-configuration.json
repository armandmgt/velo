{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["^/$"],
      "properties": { "tab": "dashboard" }
    },
    {
      "patterns": ["^/activities(/|$)"],
      "properties": { "tab": "activities" }
    },
    {
      "patterns": ["^/planned_routes(/|$)"],
      "properties": { "tab": "planned_routes" }
    },
    {
      "patterns": ["/new$", "/edit$"],
      "properties": { "context": "modal", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["/session/new$", "/users/new$"],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": false,
        "is_after_sign_out_path": true
      }
    }
  ]
}
