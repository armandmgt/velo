{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["/new$", "/edit$"],
      "properties": { "context": "modal", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["/session/new$", "/users/new$"],
      "properties": { "context": "default", "pull_to_refresh_enabled": false }
    }
  ]
}
