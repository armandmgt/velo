{
  "settings": {},
  "rules": [
    {
      "patterns": ["/.*"],
      "properties": { "context": "default", "pull_to_refresh_enabled": true }
    },
    {
      "patterns": ["/new$", "/edit$", "/users/new$", "/session/new$"],
      "properties": { "context": "modal", "pull_to_refresh_enabled": false }
    }
  ]
}
