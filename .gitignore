# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

.DS_Store
/.idea/

# Ignore compiled C extensions for local gem
/lib/ruby_fit/lib/ruby_fit/ruby_fit.bundle
/lib/ruby_fit/lib/ruby_fit/ruby_fit.so
/lib/ruby_fit/lib/ruby_fit/ruby_fit.dll
/lib/ruby_fit/tmp/

# Ignore OSM extract data
/osm/.env
/osm/data.osm.pbf

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

# Hotwire Native iOS — generated by `xcodegen generate`, not committed.
/native/ios/Velo.xcodeproj/
/native/ios/**/xcuserdata/
/native/ios/.build/
/native/ios/DerivedData/

# Hotwire Native Android — build output and local machine config.
/native/android/.gradle/
/native/android/build/
/native/android/app/build/
/native/android/local.properties
/native/android/.idea/
/native/android/captures/
/native/android/**/*.iml
# Signing credentials — never commit these
/native/android/keystore.properties
/native/android/**/*.jks
/native/android/**/*.keystore

/native/ios/build/

# Fastlane generated artifacts
/native/ios/fastlane/report.xml
/native/ios/fastlane/Preview.html
/native/ios/fastlane/screenshots
/native/ios/fastlane/test_output
/native/ios/fastlane/README.md
/native/ios/.env
/native/ios/.env.*
/native/android/fastlane/report.xml
/native/android/fastlane/Preview.html
/native/android/fastlane/screenshots
/native/android/fastlane/test_output
/native/android/fastlane/README.md
/native/android/fastlane/metadata
/native/android/.env
/native/android/.env.*
# Google Play service account JSON — never commit
/native/android/**/play-publisher*.json
/native/android/**/google-play-*.json

# Design canvas working material (.dc.html artboards, canvas.json, exported
# canvases and their assets) — local only, never committed.
/design/

# Maestro takeScreenshot artifacts land in whatever the CWD was.
record-*.png

# Maintainer-only Claude Code notes (personal infrastructure).
/CLAUDE.local.md
