<% content_for :title, @segment.name %>
<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>
<% category = @segment.sport_category.to_sym %>
<% map_id = dom_id(@segment, :map) %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <header class="not-prose flex items-center gap-3">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
      <%= icon({ cycling: "bike", running: "sport-shoe" }.fetch(category), class: "size-6") %>
    </span>
    <div>
      <h1 class="m-0 text-xl font-bold leading-tight"><%= @segment.name %></h1>
      <span class="text-xs uppercase font-semibold opacity-60">
        <%= t("activity.sport_group.#{category}") %> · <%= segment_figures(@segment) %>
      </span>
    </div>
  </header>

  <% start = @segment.path.points.first %>
  <div
    id="<%= map_id %>"
    data-controller="map"
    data-map-lng-value="<%= start.x %>"
    data-map-lat-value="<%= start.y %>"
    data-map-route-value="<%= @segment.path_geojson %>"
    class="map my-4 h-[320px] overflow-hidden rounded-box"
  ></div>

  <% if (elevation_data = @segment.elevation_chart_data) %>
    <%= render "activities/elevation_profile", elevation_data:, map_target: "##{map_id}", x_mode: "distance" %>
  <% end %>

  <section id="<%= dom_id(@segment, :own_efforts) %>" class="not-prose mb-6">
    <h3 class="text-sm font-semibold uppercase opacity-60 mb-2">Vos efforts</h3>
    <% if @efforts.any? %>
      <ol class="grid grid-cols-[auto_minmax(0,max-content)_auto_auto_1fr] gap-x-2 sm:gap-x-3 text-sm sm:text-base overflow-hidden rounded-box border border-base-300 divide-y divide-base-300">
        <% @efforts.each.with_index(1) do |effort, position| %>
          <% date = l(effort.activity.start_time.in_time_zone("Europe/Paris").to_date, format: :long) %>
          <li id="<%= dom_id(effort) %>" class="col-span-full grid grid-cols-subgrid items-center px-3 sm:px-4 py-2 whitespace-nowrap">
            <span class="text-right tabular-nums opacity-60"><%= position %></span>
            <%= link_to date, activity_path(effort.activity), title: date, class: "truncate font-semibold link link-hover" %>
            <span class="text-right font-mono tabular-nums"><%= best_effort_time(effort) %></span>
            <span class="text-right text-xs sm:text-sm opacity-60"><%= best_effort_rate(effort, category) %></span>
            <span class="flex items-center gap-1">
              <%= best_effort_badge(1) if position == 1 %>
              <%= segment_effort_private_tag(effort) %>
            </span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-sm opacity-60">Vous n'avez pas encore parcouru ce segment.</p>
    <% end %>
  </section>

  <section id="<%= dom_id(@segment, :leaderboard) %>" class="not-prose mb-6">
    <h3 class="text-sm font-semibold uppercase opacity-60 mb-2">Classement</h3>
    <% if @leaderboard.any? %>
      <table class="table table-sm">
        <thead>
          <tr><th>#</th><th>Athlète</th><th>Temps</th><th><%= category == :running ? "Allure" : "Vitesse" %></th><th>Date</th></tr>
        </thead>
        <tbody>
          <% @leaderboard.each.with_index(1) do |effort, position| %>
            <% rider = effort.activity.user %>
            <tr id="<%= dom_id(effort, :leaderboard) %>" class="<%= "bg-base-200 font-semibold" if rider == Current.user %>">
              <td><%= position %></td>
              <td><%= rider.display_name %><%= " (vous)" if rider == Current.user %></td>
              <td class="font-mono tabular-nums"><%= best_effort_time(effort) %></td>
              <td><%= best_effort_rate(effort, category) %></td>
              <td><%= l effort.activity.start_time.in_time_zone("Europe/Paris").to_date, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm opacity-60">Aucun effort public pour l'instant.</p>
    <% end %>
  </section>
</main>
