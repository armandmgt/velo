<% content_for :title, "Profil" %>

<main class="prose dark:prose-invert py-8">
  <h1 class="hotwire-native:hidden">Profil de <%= Current.user.email_address %></h1>

  <section>
    <h2>Réglages</h2>

    <%= form_with model: @user, url: user_path, method: :patch, class: "not-prose max-w-xs space-y-4" do |form| %>
      <fieldset id="profile-name">
        <%= form.label :name, "Nom d'affichage", class: "block mb-2 text-sm font-medium" %>
        <%= form.text_field :name, placeholder: @user.display_name, maxlength: 50,
              class: class_names("w-full input", { "input-error": @user.errors.include?(:name) }) %>
        <p class="mt-1 text-xs opacity-60">Utilisé pour vous accueillir sur le tableau de bord. Par défaut, dérivé de votre adresse email.</p>
      </fieldset>

      <fieldset>
        <%= form.label :max_heart_rate, t("activity.heart_rate_zone.max_hr_label"), class: "block mb-2 text-sm font-medium" %>
        <%= form.number_field :max_heart_rate, in: 100..240, placeholder: "bpm",
              class: class_names("w-full input", { "input-error": @user.errors.include?(:max_heart_rate) }) %>
        <p class="mt-1 text-xs opacity-60"><%= t("activity.heart_rate_zone.max_hr_help") %></p>
      </fieldset>

      <% suggested_ftp = @user.suggested_ftp %>
      <fieldset id="profile-ftp" <% if suggested_ftp %>data-controller="ftp-suggestion" data-ftp-suggestion-watts-value="<%= suggested_ftp %>"<% end %>>
        <%= form.label :ftp, t("activity.power_zone.ftp_label"), class: "block mb-2 text-sm font-medium" %>
        <%= form.number_field :ftp, in: 1..1000, placeholder: "W",
              data: { ftp_suggestion_target: "input" },
              class: class_names("w-full input", { "input-error": @user.errors.include?(:ftp) }) %>
        <p class="mt-1 text-xs opacity-60"><%= t("activity.power_zone.ftp_help") %></p>
        <% if suggested_ftp && suggested_ftp != @user.ftp %>
          <p class="mt-1 flex items-center gap-2 text-xs">
            <span><%= t("activity.power_zone.ftp_suggestion", watts: suggested_ftp) %></span>
            <button type="button" class="btn btn-xs" data-action="ftp-suggestion#apply"><%= t("activity.power_zone.ftp_apply") %></button>
          </p>
        <% end %>
      </fieldset>

      <%= form.submit "Enregistrer", class: "btn btn-primary" %>
    <% end %>
  </section>

  <section id="map-visibility">
    <h2>Visibilité de la carte</h2>
    <p class="text-sm opacity-70">Ces réglages s'appliquent aux activités que vous partagez, y compris celles déjà partagées. Vous voyez toujours vos propres cartes en entier, et les statistiques restent complètes.</p>

    <%= form_with model: @user, url: user_path, method: :patch, class: "not-prose max-w-xs space-y-4" do |form| %>
      <fieldset>
        <%= form.label :map_hide_start_end_distance, "Masquer le début et la fin", class: "block mb-2 text-sm font-medium" %>
        <%= form.select :map_hide_start_end_distance,
              User::MAP_HIDE_DISTANCE_OPTIONS.map { [ map_distance_label(it), it ] },
              {}, class: "w-full select" %>
        <p class="mt-1 text-xs opacity-60">Distance masquée le long du tracé, au départ et à l'arrivée de chaque activité.</p>
      </fieldset>

      <%= form.submit "Enregistrer", class: "btn btn-primary" %>
    <% end %>

    <h3>Zones masquées</h3>
    <p class="text-sm opacity-70">Tout passage dans une de ces zones est masqué, y compris en milieu d'activité.</p>

    <ul class="not-prose flex flex-col gap-2 mb-4">
      <% @map_privacy_zones.each do |zone| %>
        <li id="<%= dom_id zone %>" class="flex items-center justify-between gap-3 rounded-box bg-base-200 px-4 py-3">
          <span>
            <span class="font-medium"><%= zone.name || "Zone sans nom" %></span>
            <span class="text-sm opacity-60">· rayon <%= map_distance_label(zone.radius) %></span>
          </span>
          <%= link_to "Modifier", edit_map_privacy_zone_path(zone), class: "btn btn-sm" %>
        </li>
      <% end %>
    </ul>

    <%= link_to "Ajouter une zone", new_map_privacy_zone_path, class: "btn not-prose" %>
  </section>

  <section>
    <h2 class="text-error">Zone dangereuse</h2>

    <%= button_to "Supprimer mon compte", user_path(Current.user), method: :delete, data: { turbo_confirm: "Etes-vous sûr de vouloir supprimer votre compte ?" }, class: "btn btn-error" %>
  </section>

  <section>
    <h2>À propos</h2>

    <ul class="not-prose flex flex-col gap-1">
      <li><%= link_to "Support", support_path, class: "link" %></li>
      <li><%= link_to "Politique de confidentialité", privacy_path, class: "link" %></li>
    </ul>
  </section>
</main>
