<main class="prose dark:prose-invert md:py-16 py-8">
  <header class="flex justify-between items-center mb-4">
    <h1 class="mt-0 mb-0">Users</h1>

    <%= link_to new_user_path, class: "btn btn-primary btn-lg" do %>
      <%= lucide_icon "plus", class: "size-[1.4em]" %>
      <span class="hidden sm:block">Nouveau user</span>
    <% end %>
  </header>

  <section id="users">
    <% if @users.empty? %>
      <p class="text-center">
        Vous n’avez aucun user pour le moment.
      </p>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 justify-items-center">
        <% @users.each do |user| %>
          <%= render user %>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
