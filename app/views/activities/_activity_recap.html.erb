<%# locals: (activity:) %>

<article id="<%= dom_id activity %>" class="w-full sm:w-auto">
  <div class="flex items-center justify-between w-full">
    <div>
      <span class="text-xs uppercase font-semibold opacity-60">
        <%= l activity.start_time.in_time_zone("Europe/Paris"), format: :long %>
        -
        <%= activity.location %>
      </span>

      <h2 class="text-lg font-semibold flex items-center gap-2">
        <%= icon activity.sport_icon_name, class: "size-[1.2em]" %>
        <%= activity.name %>
      </h2>
    </div>

    <%= link_to activity_path(activity), class: "btn btn-ghost btn-circle" do %>
      <%= icon "arrow-right", class: "size-[1.2em]" %>
    <% end %>
  </div>

  <p class="mb-3">
    <%= activity.description %>
  </p>

  <div class="stats stats-vertical sm:stats-horizontal bg-base-300 shadow w-full sm:w-auto">
    <div class="stat">
      <div class="stat-title">Distance</div>
      <div class="stat-value text-primary"><%= (activity.distance / 1000.0).round(2) %> km</div>
    </div>

    <div class="stat">
      <div class="stat-title">Durée de déplacement</div>
      <div class="stat-value text-primary"><%= duration_display activity.active_time_duration %></div>
    </div>

    <div class="stat">
      <div class="stat-title">Dénivelé positif</div>
      <div class="stat-value text-primary"><%= activity.total_elevation_gain.to_i %> m</div>
    </div>
  </div>
</article>
