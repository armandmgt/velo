<% content_for :title, "Showing activity" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing activity</h1>

  <%= render @activity %>

  <%= link_to "Edit this activity", edit_activity_path(@activity), class: "btn" %>
  <%= link_to "Back to activities", activities_path, class: "btn" %>
  <%= button_to "Destroy this activity", @activity, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
</div>
