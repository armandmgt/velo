<main class="prose dark:prose-invert md:py-16 p-4">
  <header class="flex justify-between items-center mb-4">
    <h1 class="mt-0 mb-0"></h1>
  </header>

  <% if notice.present? %>
    <div role="alert" class="alert alert-success">
      <%= icon "circle-check", class: "h-6 w-6 shrink-0 stroke-current" %>
      <span><%= notice %></span>
    </div>
  <% end %>

  <section class="mb-4">
    <%= render @activity %>
  </section>

  <section class="mb-4">
    <%= link_to "Modifier", edit_activity_path(@activity), class: "btn" %>
    <%= button_to "Supprimer", @activity, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "btn btn-error", data: { turbo_confirm: "Voulez vous vraiment supprimer cette activité ?" } %>
  </section>

  <%= link_to "Retour à la liste", activities_path, class: "" %>
</main>
