<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>

<article id="<%= dom_id activity %>" class="w-full sm:w-auto">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-1">
    <div>
      <h2 class="flex items-center gap-2 mt-0">
        <%= icon activity.sport_icon_name, class: "size-[1.2em]" %>
        <%= activity.name %>
      </h2>

      <span class="text-xs uppercase font-semibold opacity-60">
        <%= l activity.start_time.in_time_zone("Europe/Paris"), format: :long %>
        -
        <%= activity.location %>
      </span>
    </div>

    <div>
      <div class="stats bg-base-300 shadow">
        <div class="stat">
          <div class="stat-title">Distance</div>
          <div class="stat-value text-primary"><%= (activity.distance / 1000.0).round(2) %> km</div>
        </div>

        <div class="stat">
          <div class="stat-title">Durée de déplacement</div>
          <div class="stat-value text-primary"><%= duration_display activity.active_time_duration %></div>
        </div>

        <div class="stat">
          <div class="stat-title">Dénivelé positif</div>
          <div class="stat-value text-primary"><%= activity.total_elevation_gain.to_i %> m</div>
        </div>
      </div>
    </div>
  </div>

  <% if activity.description.present? %>
    <p>
      <%= activity.description %>
    </p>
  <% end %>

  <% if activity.path.present? %>
    <div
      data-controller="map"
      data-map-lng-value="<%= activity.path.points.first.x %>"
      data-map-lat-value="<%= activity.path.points.first.y %>"
      data-map-route-value="<%= activity.path_geojson %>"
      class="map my-3 max-h-[350px]"
    ></div>
  <% end %>

  <% if (elevation_data = activity.elevation_chart_data) %>
    <%= render "activities/elevation_profile", elevation_data: elevation_data %>
  <% end %>

  <%= render "activities/activity_charts", activity: activity %>
</article>
