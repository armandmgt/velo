<div id="<%= dom_id activity %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= activity.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= activity.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sport:</strong>
    <%= activity.sport %>
  </div>
</div>
