<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>

<% max_hr = activity.user.max_heart_rate %>
<% chart_data = activity.chart_data(max_heart_rate: max_hr) %>
<% hr_zones = activity.heart_rate_zone_distribution(max_hr) %>
<% map_id = dom_id(activity, :map) %>

<article id="<%= dom_id activity %>" class="w-full">
  <header class="flex items-center gap-3">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
      <%= icon activity.sport_icon_name, class: "size-6" %>
    </span>
    <div>
      <h2 class="mt-0 mb-0 text-xl font-bold leading-tight"><%= activity.name %></h2>
      <span class="text-xs uppercase font-semibold opacity-60">
        <%= l activity.start_time.in_time_zone("Europe/Paris"), format: :long %>
        · <%= activity.location %>
      </span>
    </div>
  </header>

  <% if activity.description.present? %>
    <p class="mt-3 opacity-80"><%= activity.description %></p>
  <% end %>

  <div class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-box bg-base-300 sm:grid-cols-3 lg:grid-cols-4">
    <% activity_summary_metrics(activity).each do |metric| %>
      <div class="flex flex-col gap-1 bg-base-100 p-4">
        <span class="flex items-center gap-1.5 text-xs uppercase font-semibold opacity-60">
          <%= icon metric[:icon], class: "size-3.5" %>
          <%= metric[:label] %>
        </span>
        <span class="text-2xl font-bold text-primary"><%= metric[:value] %></span>
      </div>
    <% end %>
  </div>

  <% if activity.path.present? %>
    <div
      id="<%= map_id %>"
      data-controller="map"
      data-map-lng-value="<%= activity.path.points.first.x %>"
      data-map-lat-value="<%= activity.path.points.first.y %>"
      data-map-route-value="<%= activity.path_geojson %>"
      class="map my-4 h-[400px] overflow-hidden rounded-box"
    ></div>
  <% end %>

  <% if (elevation_data = activity.elevation_chart_data) %>
    <%= render "activities/elevation_profile", elevation_data: elevation_data %>
  <% end %>

  <%= render "activities/activity_charts", activity: activity, chart_data: chart_data, map_target: "##{map_id}" %>

  <% if hr_zones %>
    <%= render "activities/heart_rate_zones", zones: hr_zones %>
  <% elsif max_hr.nil? && activity.avg_heart_rate %>
    <p class="mt-4 text-sm opacity-60">
      <%= t("activity.heart_rate_zone.set_max_hr_hint_html", link: link_to(t("activity.heart_rate_zone.set_max_hr_link"), user_path)) %>
    </p>
  <% end %>
</article>
