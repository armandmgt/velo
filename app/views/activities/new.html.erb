<% content_for :title, "Nouvelle activité" %>

<%# The native shells reuse this page as the recording review screen (#116,
    ADR 0003). The review chrome is rendered here rather than hidden
    client-side, so the web upload form keeps its own HTML and there is no flash
    of the wrong screen while the bridge connects. %>
<% if hotwire_native_app? %>
  <%= render "recording_review", activity: @activity %>
<% else %>
  <main class="prose dark:prose-invert md:py-16 p-4">
    <header class="flex justify-between items-center mb-4 hotwire-native:hidden">
      <h1 class="mt-0 mb-0">Nouvelle activité</h1>
    </header>

    <section id="new_activity" class="mb-4">
      <%= render "form", activity: @activity %>
    </section>

    <%= link_to "Retour aux activités", activities_path %>
  </main>
<% end %>
