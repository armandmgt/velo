<%# locals: (activity:)  %>

<div
  data-controller="activity-charts"
  data-activity-charts-data-value="<%= activity.chart_data.to_json %>"
>
  <select data-action="activity-charts#changeDataset" class="select" autocomplete="off">
    <% activity.chart_data[:datasets].each_with_index do |dataset, index| %>
      <option value="<%= index %>"><%= dataset[:label] %></option>
    <% end %>
  </select>

  <canvas data-activity-charts-target="canvas"></canvas>
</div>
