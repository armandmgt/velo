<% content_for :title, "Activités" %>

<%= turbo_stream_from Current.user, :activities %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 pt-5 sm:pt-8 pb-16 sm:pb-20">
  <header class="flex items-center justify-between gap-3 mb-5 sm:mb-6">
    <h1 class="text-2xl sm:text-[26px] font-extrabold tracking-tight m-0 hotwire-native:hidden">Activités</h1>

    <%# Hidden in the native shells — the tab-bar FAB opens this form there. %>
    <%= link_to new_activity_path, class: "btn btn-primary hotwire-native:hidden" do %>
      <%= icon "plus", class: "size-[1.4em]" %>
      <span class="hidden sm:block">Nouvelle activité</span>
    <% end %>
  </header>

  <% if @activities.empty? %>
    <p class="opacity-60">Vous n’avez aucune activité pour le moment.</p>
  <% else %>
    <div id="activities" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% @activities.each do |activity| %>
        <%= render "activities/activity_card", activity: activity %>
      <% end %>
    </div>
  <% end %>
</main>
