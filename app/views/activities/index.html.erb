<% content_for :title, "Activités" %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <header class="flex justify-between items-center mb-4 gap-3">
    <h1 class="mt-0 mb-0 hotwire-native:hidden">Activités</h1>

    <div class="flex items-center gap-2">
      <%= link_to new_activity_path, class: "btn btn-primary btn-lg" do %>
        <%= icon "plus", class: "size-[1.4em]" %>
        <span class="hidden sm:block">Nouvelle activité</span>
      <% end %>
    </div>
  </header>

  <section id="activities" class="not-prose">
    <% if @activities.empty? %>
      <p class="text-center">
        Vous n’avez aucune activité pour le moment.
      </p>
    <% else %>
      <ul class="list bg-base-100 rounded-box shadow-md">
        <% @activities.each do |activity| %>
          <li class="list-row">
            <div class="list-col-grow">
              <%= render "activities/activity_recap", activity: activity %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
