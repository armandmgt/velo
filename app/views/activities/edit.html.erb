<% content_for :title, @activity.name.present? ? "Modifier #{@activity.name}" : "Modifier l'activité" %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <header class="flex justify-between items-center mb-4 hotwire-native:hidden">
    <h1 class="mt-0 mb-0">Modifier l'activité</h1>
  </header>

  <section id="<%= dom_id(@activity) %>" class="mb-4">
    <%= render "form", activity: @activity %>
  </section>

  <%= link_to "Voir l'activité", activity_path(@activity) %>
  <%= link_to "Retour aux activités", activities_path %>
</main>
