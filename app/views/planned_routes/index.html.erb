<% content_for :title, t("planned_route.index.title") %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <header class="flex justify-between items-center mb-4 gap-3">
    <h1 class="mt-0 mb-0 hotwire-native:hidden"><%= t("planned_route.index.title") %></h1>

    <%= link_to new_planned_route_path, class: "btn btn-primary btn-lg" do %>
      <%= icon "plus", class: "size-[1.4em]" %>
      <span class="hidden sm:block"><%= t("planned_route.index.new") %></span>
    <% end %>
  </header>

  <section id="planned_routes" class="not-prose">
    <% if @planned_routes.empty? %>
      <p class="text-center"><%= t("planned_route.index.empty") %></p>
    <% else %>
      <ul class="list bg-base-100 rounded-box shadow-md">
        <% @planned_routes.each do |planned_route| %>
          <li class="list-row">
            <div class="list-col-grow">
              <%= render "planned_routes/planned_route_recap", planned_route: planned_route %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
