<% content_for :title, t("planned_route.new.title") %>

<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>

<main class="relative h-[calc(100dvh-4rem)] hotwire-native:h-dvh w-full overflow-hidden">
  <%= render "form",
             planned_route: @planned_route,
             title: t("planned_route.new.title"),
             back_path: planned_routes_path,
             back_label: t("planned_route.new.back") %>
</main>
