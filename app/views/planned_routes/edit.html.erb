<% content_for :title, t("planned_route.edit.title") %>

<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>

<main class="prose dark:prose-invert md:py-16 p-4 max-w-5xl">
  <header class="flex justify-between items-center mb-4 hotwire-native:hidden">
    <h1 class="mt-0 mb-0"><%= t("planned_route.edit.title") %></h1>
  </header>

  <%= render "form", planned_route: @planned_route %>

  <%= link_to t("planned_route.edit.back"), @planned_route %>
</main>
