<% content_for :title, @planned_route.name %>

<%= content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
  <%= javascript_tag do %>
    window.MAPTILER_API_KEY = "<%= Rails.application.credentials.maptiler_api_key %>"
  <% end %>
<% end %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <article class="w-full">
    <header class="flex items-center gap-3">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
        <%= icon @planned_route.sport_icon_name, class: "size-6" %>
      </span>
      <div>
        <h1 class="mt-0 mb-0 text-xl font-bold leading-tight"><%= @planned_route.name %></h1>
        <span class="text-xs uppercase font-semibold opacity-60">
          <%= t("activity.sport.#{@planned_route.sport}") %>
        </span>
      </div>
    </header>

    <div class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-box bg-base-300 sm:grid-cols-3">
      <div class="flex flex-col gap-1 bg-base-100 p-4">
        <span class="flex items-center gap-1.5 text-xs uppercase font-semibold opacity-60">
          <%= icon "ruler", class: "size-3.5" %>
          <%= t("activity.metric.distance") %>
        </span>
        <span class="text-2xl font-bold text-primary">
          <%= @planned_route.distance_meters ? "#{(@planned_route.distance_meters / 1000.0).round(2)} km" : "—" %>
        </span>
      </div>
      <div class="flex flex-col gap-1 bg-base-100 p-4">
        <span class="flex items-center gap-1.5 text-xs uppercase font-semibold opacity-60">
          <%= icon "mountain", class: "size-3.5" %>
          <%= t("activity.metric.elevation_gain") %>
        </span>
        <span class="text-2xl font-bold text-primary">
          <%= @planned_route.elevation_gain_meters ? "#{@planned_route.elevation_gain_meters} m" : "—" %>
        </span>
      </div>
      <div class="flex flex-col gap-1 bg-base-100 p-4">
        <span class="flex items-center gap-1.5 text-xs uppercase font-semibold opacity-60">
          <%= icon "waypoints", class: "size-3.5" %>
          <%= t("planned_route.show.waypoints") %>
        </span>
        <span class="text-2xl font-bold text-primary"><%= @planned_route.waypoints.length %></span>
      </div>
    </div>

    <% if @planned_route.path.present? %>
      <div
        id="<%= dom_id(@planned_route, :map) %>"
        data-controller="map"
        data-map-lng-value="<%= @planned_route.path.points.first.x %>"
        data-map-lat-value="<%= @planned_route.path.points.first.y %>"
        data-map-route-value="<%= @planned_route.path_geojson %>"
        class="map my-4 h-[500px] overflow-hidden rounded-box"
      ></div>
    <% end %>
  </article>

  <section class="mb-4">
    <%= button_to t("planned_route.show.delete"),
                  @planned_route,
                  method: :delete,
                  form_class: "inline-block",
                  class: "btn btn-error",
                  data: { turbo_confirm: t("planned_route.show.confirm_delete") } %>
  </section>

  <%= link_to t("planned_route.show.back"), planned_routes_path %>
</main>
