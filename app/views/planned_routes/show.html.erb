<% content_for :title, @planned_route.name %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <%= render @planned_route %>

  <section class="mb-4">
    <%= render "planned_routes/share_section", planned_route: @planned_route %>
  </section>

  <section class="mb-4 flex flex-wrap gap-2">
    <%= link_to t("planned_route.show.edit"),
                edit_planned_route_path(@planned_route),
                class: "btn btn-primary" %>
    <% if @planned_route.path.present? %>
      <%= link_to planned_route_path(@planned_route, format: :gpx),
                  class: "btn btn-secondary" do %>
        <%= icon "download", class: "size-[1.2em]" %>
        <%= t("planned_route.show.export_gpx") %>
      <% end %>
    <% end %>
    <%= button_to t("planned_route.show.delete"),
                  @planned_route,
                  method: :delete,
                  form_class: "inline-block",
                  class: "btn btn-error",
                  data: { turbo_confirm: t("planned_route.show.confirm_delete") } %>
  </section>

  <%= link_to t("planned_route.show.back"), planned_routes_path %>
</main>
