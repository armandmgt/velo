<%# locals: (planned_route:) %>
<%= link_to planned_route, class: "flex items-center gap-3 p-3 no-underline" do %>
  <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
    <%= icon planned_route.sport_icon_name, class: "size-6" %>
  </span>
  <div class="flex-1 min-w-0">
    <h3 class="m-0 text-base font-bold leading-tight truncate"><%= planned_route.name %></h3>
    <span class="text-xs uppercase font-semibold opacity-60">
      <%= t("activity.sport.#{planned_route.sport}") %>
      <% if planned_route.distance_meters %>
        · <%= (planned_route.distance_meters / 1000.0).round(1) %> km
      <% end %>
      <% if planned_route.elevation_gain_meters %>
        · <%= planned_route.elevation_gain_meters %> m D+
      <% end %>
    </span>
  </div>
<% end %>
