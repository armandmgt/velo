<%# locals: (activities:, components: Current.user.overdue_gear_components) %>
<% count = activities.size + components.size %>

<div
  id="navbar_name_prompts"
  class="<%= class_names(
               "dropdown static",
               "sm:relative sm:dropdown-end"
             ) %>"
  data-controller="bridge--notification-count"
  data-bridge--notification-count-count-value="<%= count %>"
>
  <button class="btn btn-ghost btn-circle">
    <span class="indicator">
      <%= icon "bell", class: "size-5" %>
      <% if count.positive? %>
        <span class="badge badge-sm badge-accent indicator-item">
          <%= count %>
        </span>
      <% end %>
    </span>
  </button>
  <ul
    class="<%= class_names(
                 "dropdown-content list bg-base-100 rounded-box z-1 mt-4 p-2 shadow-md",
                 "max-sm:left-1 max-sm:right-1 sm:w-96",
               ) %>"
  >
    <li class="p-4 pb-2 text-xs opacity-60 tracking-wide">
      Sorties à nommer
    </li>
    <% if activities.any? %>
      <% activities.each do |activity| %>
        <li class="px-4">
          <%= render "activities/name_prompt", activity: activity, context: "nav" %>
        </li>
      <% end %>
    <% else %>
      <li class="px-4 pb-3 text-sm opacity-40 italic">
        Tout est à jour, rien à nommer.
      </li>
    <% end %>
    <% if components.any? %>
      <li class="p-4 pb-2 text-xs opacity-60 tracking-wide">
        Entretien à prévoir
      </li>
      <% components.each do |component| %>
        <li id="<%= dom_id(component, :bell) %>" class="px-4 py-2">
          <%= link_to gear_path(component.gear), class: "flex items-center gap-2 text-sm hover:text-primary" do %>
            <%= icon "wrench", class: "size-4 text-error shrink-0" %>
            <span>
              <span class="font-semibold"><%= component.gear.name %></span> ·
              <%= component_progress_label(component) %>
            </span>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>
</div>
