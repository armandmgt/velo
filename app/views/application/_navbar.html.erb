<div
  class="navbar bg-base-100 sticky top-0 z-3 shadow-sm hotwire-native:hidden"
  data-controller="bridge--navbar-buttons"
>
  <div class="flex-1">
    <a href="/" class="btn btn-ghost text-xl">
      <img
        src="/icon.svg"
        class="mr-1 size-6"
        alt="BienVert Logo"
        />

      <span>Velo</span>
    </a>
  </div>
  <div class="flex-none">
    <% unless current_page?(activities_path) %>
      <%= link_to new_activity_path, class: "btn btn-primary btn-sm" do %>
        <%= icon "plus", class: "size-[1.4em]" %>
        <span class="hidden sm:block">Nouvelle activité</span>
      <% end %>
    <% end %>

    <% unless content_for?(:bridge_navbar_buttons) %>
      <%= render "application/name_prompts_nav",
                 activities: Current.user.activities.awaiting_name.order(start_time: :desc) %>
    <% end %>

    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full">
          <%= icon "user", class: "size-10" %>
        </div>
      </div>
      <ul
        tabindex="-1"
        class="menu dropdown-content bg-base-100 rounded-box z-1 mt-4 w-60 p-2 shadow"
      >
        <li class="menu-title flex flex-col gap-0.5">
          <span class="text-xs opacity-60">Connecté en tant que</span>
          <span class="truncate font-medium text-base-content"><%= Current.user.email_address %></span>
        </li>
        <li>
          <%= link_to user_path, data: bridge_nav_item_data do %>
            <%= icon "user", class: "size-[1.2em]" %>
            Profil
          <% end %>
        </li>
        <li>
          <%= link_to activities_path do %>
            <%= icon "bike", class: "size-[1.2em]" %>
            Activités
          <% end %>
        </li>
        <li>
          <%= link_to planned_routes_path do %>
            <%= icon "route", class: "size-[1.2em]" %>
            <%= t("planned_route.nav.label") %>
          <% end %>
        </li>
        <li>
          <%= link_to gears_path do %>
            <%= icon "wrench", class: "size-[1.2em]" %>
            Matériel
          <% end %>
        </li>
        <li>
          <%= link_to edit_igpsport_connection_path, data: bridge_nav_item_data do %>
            <%= icon "cable", class: "size-[1.2em]" %>
            Intégrations
          <% end %>
        </li>
        <li><hr class="my-1 border-base-content/10" /></li>
        <li>
          <%= button_to session_path, method: :delete, class: "flex w-full items-center gap-2 text-error", form_class: "w-full", data: bridge_nav_item_data("bridge-ios-image": "power", "bridge-android-image": "logout") do %>
            <%= icon "log-out", class: "size-[1.2em] shrink-0" %>
            Se déconnecter
          <% end %>
        </li>
      </ul>
    </div>
  </div>

  <%= yield :bridge_navbar_buttons if content_for?(:bridge_navbar_buttons) %>
</div>
