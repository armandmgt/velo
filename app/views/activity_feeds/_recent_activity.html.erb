<%# locals: (activity:) %>
<%= link_to activity_path(activity),
            class: "flex items-center gap-3.5 bg-base-100 border border-base-300 rounded-box p-3 sm:p-3.5 hover:bg-base-200 transition-colors" do %>
  <%= activity_route_thumbnail(activity, css_class: "size-15 shrink-0 rounded-box") %>

  <div class="flex-1 min-w-0">
    <div class="text-[10.5px] uppercase tracking-wide font-semibold opacity-55 truncate">
      <%= l activity.start_time.in_time_zone("Europe/Paris"), format: :long %> · <%= activity.location %>
    </div>
    <div class="flex items-center gap-1.5 text-[15px] font-bold mt-0.5">
      <%= icon activity.sport_icon_name, class: "size-4 shrink-0 text-primary" %>
      <span class="truncate"><%= activity.name %></span>
    </div>
    <div class="flex gap-3.5 mt-1.5 text-xs opacity-70">
      <% if activity.distance %>
        <span><b class="text-primary"><%= (activity.distance / 1000.0).round %></b> km</span>
      <% end %>
      <span><%= duration_display activity.active_time_duration %></span>
      <% if activity.total_elevation_gain %>
        <span><%= activity.total_elevation_gain.to_i %> m D+</span>
      <% end %>
    </div>
  </div>

  <%= icon "chevron-right", class: "size-5 opacity-40 shrink-0" %>
<% end %>
