<% content_for :title, "Tableau de bord" %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 pt-5 sm:pt-8 pb-16 sm:pb-20">
  <h1 class="sr-only">Tableau de bord</h1>

  <%= render "activities/name_prompts_banner",
             activities: Current.user.activities.awaiting_name.order(start_time: :desc) %>

  <div data-controller="dashboard-tabs">
    <%# Greeting + period toggle %>
    <div class="flex flex-col gap-3.5 sm:flex-row sm:items-center sm:justify-between mb-5 sm:mb-6">
      <h2 class="group flex items-center gap-2 text-2xl sm:text-[26px] font-extrabold tracking-tight m-0">
        <span>Bonjour, <%= Current.user.display_name %></span>
        <%= link_to user_path(anchor: "profile-name"),
                    class: "opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity text-base-content/40 hover:text-primary",
                    title: "Modifier le nom", aria: { label: "Modifier le nom d'affichage" } do %>
          <%= icon "pencil", class: "size-4" %>
        <% end %>
      </h2>
      <div class="flex w-full sm:w-[340px]">
        <% @periods.each_with_index do |period, i| %>
          <button type="button"
                  data-dashboard-tabs-target="tab"
                  data-period="<%= period[:key] %>"
                  data-action="dashboard-tabs#select"
                  class="flex-1 px-1.5 py-2.5 text-[13px] font-semibold text-center cursor-pointer border border-base-300 <%= "-ml-px" unless i.zero? %> transition-colors <%= period[:key] == "week" ? "bg-neutral text-neutral-content" : "bg-base-100 text-base-content" %>">
            <%= period[:tab] %>
          </button>
        <% end %>
      </div>
    </div>

    <%# One hero + secondary strip per period; the controller shows the active one %>
    <% @periods.each do |period| %>
      <%= render "period_panel", period: period %>
    <% end %>

    <%# Personal records — only revealed on the "Tout" tab %>
    <% if @cycling_records || @running_records %>
      <section data-dashboard-tabs-target="records" class="hidden mt-6 sm:mt-7">
        <h3 class="text-[13px] font-bold uppercase tracking-wide opacity-55 mb-3">Records personnels</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <% if @cycling_records %>
            <%= render "records", label: "Cyclisme", records: @cycling_records, icon_name: "bike", show_elevation: true %>
          <% end %>
          <% if @running_records %>
            <%= render "records", label: "Course", records: @running_records, icon_name: "sport-shoe", show_elevation: false %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Recent activities %>
    <section class="mt-6 sm:mt-7">
      <h3 class="text-[13px] font-bold uppercase tracking-wide opacity-55 mb-3">Activités récentes</h3>
      <% if @recent_activities.none? %>
        <p class="opacity-60">Aucune activité pour le moment.</p>
      <% else %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @recent_activities.each do |activity| %>
            <%= render "recent_activity", activity: activity %>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</main>
