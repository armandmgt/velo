<% content_for :title, "Modifier la zone masquée" %>

<main class="prose dark:prose-invert md:py-16 p-4">
  <h1 class="hotwire-native:hidden">Modifier la zone masquée</h1>

  <%= render "form", zone: @zone %>

  <%= button_to "Supprimer la zone", @zone, method: :delete, form_class: "mt-4",
        class: "btn btn-error", data: { turbo_confirm: "Supprimer cette zone masquée ?" } %>

  <p><%= link_to "Retour au profil", user_path(anchor: "map-visibility") %></p>
</main>
