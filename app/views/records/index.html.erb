<% content_for :title, "Records" %>
<% category = @records.category %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 pt-5 sm:pt-8 pb-16 sm:pb-20">
  <header class="flex flex-col gap-3.5 sm:flex-row sm:items-center sm:justify-between mb-5 sm:mb-6">
    <h1 class="text-2xl sm:text-[26px] font-extrabold tracking-tight m-0">Records</h1>

    <div class="flex flex-wrap items-center gap-2">
      <div role="tablist" class="tabs tabs-box tabs-sm">
        <% PersonalRecords::CATEGORIES.each do |cat| %>
          <%= link_to t("activity.sport_group.#{cat}"), records_path(category: cat, year: @records.year),
                      role: "tab", class: [ "tab", { "tab-active": cat == category } ],
                      aria: { selected: cat == category } %>
        <% end %>
      </div>

      <%= form_with url: records_path, method: :get, data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
        <%= form.hidden_field :category, value: category %>
        <%= form.hidden_field :curve_period, value: @power_curve.period if @power_curve %>
        <%= form.label :year, "Année", class: "sr-only" %>
        <%= form.select :year, options_for_select(@years, @records.year),
                        { include_blank: "Toutes les années" },
                        class: "select select-sm w-44", data: { action: "change->auto-submit#submit" } %>
      <% end %>
    </div>
  </header>

  <% if category == :cycling %>
    <% ride_records = [
         [ "Plus longue sortie", "ruler", @records.longest_ride, ->(a) { "#{(a.distance / 1000.0).round(1)} km" } ],
         [ "Plus gros dénivelé", "mountain", @records.biggest_climb, ->(a) { "#{a.total_elevation_gain.to_i} m" } ]
       ] %>
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-6">
      <% ride_records.each do |label, icon_name, activity, value| %>
        <div class="bg-base-100 border border-base-300 rounded-box p-3.5 sm:p-4">
          <div class="flex items-center gap-1.5 text-xs uppercase font-semibold opacity-60">
            <%= icon icon_name, class: "size-3.5" %>
            <%= label %>
          </div>
          <% if activity %>
            <div class="mt-1 text-2xl font-bold text-primary"><%= value.call(activity) %></div>
            <%= link_to activity.name, activity_path(activity), class: "link link-hover text-sm" %>
            <span class="text-sm opacity-60">· <%= l activity.start_time.in_time_zone(PersonalRecords::ZONE).to_date, format: :long %></span>
          <% else %>
            <div class="mt-1 text-2xl font-bold opacity-40">—</div>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section id="best_effort_records">
    <h2 class="text-[13px] font-bold uppercase tracking-wide opacity-55 mb-3">Meilleurs efforts</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      <% @records.distances.each_key do |distance| %>
        <%= render "records/podium", key: distance, podium: @records.podiums.fetch(distance, []), category: %>
      <% end %>
    </div>
  </section>

  <% if @power_curve && !@power_curve.empty? %>
    <section id="power_records" class="mt-8">
      <h2 class="text-[13px] font-bold uppercase tracking-wide opacity-55 mb-3">Puissance</h2>

      <div id="power_curve" class="bg-base-100 border border-base-300 rounded-box p-3.5 sm:p-4 mb-3.5"
           data-controller="power-curve-chart"
           data-power-curve-chart-data-value="<%= @power_curve.chart_data.to_json %>"
           data-power-curve-chart-labels-value="<%= { all_time: t("power_curve.all_time"), compared: @power_curve.periods.fetch(@power_curve.period) }.to_json %>">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <h3 class="font-bold text-sm m-0"><%= t("power_curve.title") %></h3>
          <%= form_with url: records_path, method: :get, data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
            <%= form.hidden_field :category, value: category %>
            <%= form.hidden_field :year, value: @records.year if @records.year %>
            <%= form.label :curve_period, t("power_curve.compare_label"), class: "text-xs opacity-60 mr-1" %>
            <%= form.select :curve_period, options_for_select(@power_curve.periods.invert, @power_curve.period), {},
                            class: "select select-sm w-44", data: { action: "change->auto-submit#submit" } %>
          <% end %>
        </div>
        <div class="relative h-64">
          <canvas id="power_curve_canvas" data-turbo-permanent data-power-curve-chart-target="canvas" role="img" aria-label="<%= t("power_curve.aria") %>"></canvas>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <% @records.power_durations.each_key do |key| %>
          <%= render "records/podium", key:, podium: @records.podiums.fetch(key, []), category:,
                                       label: t("best_effort.power_label", duration: best_effort_label(key)) %>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
