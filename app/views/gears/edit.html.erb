<% content_for :title, "Modifier #{@gear.name}" %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 pt-5 sm:pt-8 pb-16">
  <h1 class="text-2xl font-extrabold tracking-tight mb-5 hotwire-native:hidden">Modifier <%= @gear.name %></h1>

  <%= render "form", gear: @gear %>

  <p class="mt-6"><%= link_to "Retour", gear_path(@gear), class: "link" %></p>
</main>
